NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DEV_MODE=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
GEMINI_API_KEY=
AVANTIQO_REASONING_MODEL=
AVANTIQO_REASONING_PROVIDER=avantiqo-intelligence
AVANTIQO_IDEAS_PER_PROBLEM=

# Shared Modal credentials for Avantiqo-owned compute. Keep secret; never expose client-side.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
AVANTIQO_MODAL_ENVIRONMENT=

# Legacy RunPod credentials remain only for owned engines that have not yet been
# independently verified as Modal-only. Intelligence must never read these.
RUNPOD_API_KEY=
RUNPOD_MANAGEMENT_API_KEY=

# Avantiqo-owned Synthetic Intelligence (direct Modal H100 Fast + Deep functions)
AVANTIQO_INTELLIGENCE_ENGINE_ENABLED=false
AVANTIQO_INTELLIGENCE_MODEL=Qwen/Qwen3-30B-A3B-Thinking-2507
AVANTIQO_INTELLIGENCE_TIMEOUT_MS=300000
AVANTIQO_INTELLIGENCE_QUALITY_SCORE=94
AVANTIQO_INTELLIGENCE_SPEED_SCORE=76
AVANTIQO_INTELLIGENCE_RELIABILITY_SCORE=86

# Governed continuous Intelligence/Learning. Keep disabled until the platform organization
# and bounded spend path are intentionally configured. Health treats missing configuration
# as non-operational rather than silently calling it successful learning.
AVANTIQO_CONTINUOUS_LEARNING_ENABLED=false
AVANTIQO_INTELLIGENCE_LEARNING_ORGANIZATION_ID=
AVANTIQO_CONTINUOUS_LEARNING_DAILY_MAX_RUNS=8
AVANTIQO_CONTINUOUS_LEARNING_STALE_HOURS=6

# Server-only HMAC keyring for persisted mission-outcome authenticity.
# KEYRING_JSON is a JSON object mapping key ids to 256/512-bit hex keys. Keep current and
# still-trusted retired verification keys during rotation. Never expose client-side or store
# key material in Supabase rows; persisted observations contain only key id + HMAC.
AVANTIQO_MISSION_OUTCOME_AUTH_ACTIVE_KEY_ID=
AVANTIQO_MISSION_OUTCOME_AUTH_KEYRING_JSON=

# Governed Intelligence model-improvement controls. Disabled until explicitly enabled.
# No provider endpoint is configured here; any future compute path must be separately governed.
AVANTIQO_INTELLIGENCE_TRAINER_ENABLED=false
AVANTIQO_INTELLIGENCE_CANDIDATE_ENGINE_ENABLED=false
AVANTIQO_INTELLIGENCE_CANDIDATE_MODEL_CANDIDATE_ID=

# Avantiqo-owned Code Intelligence
RUNPOD_AVANTIQO_CODE_ENDPOINT_ID=

# Avantiqo-owned Image
RUNPOD_AVANTIQO_IMAGE_API_KEY=
RUNPOD_AVANTIQO_IMAGE_ENDPOINT_ID=

# Avantiqo-owned Synthetic Video / Cinema
AVANTIQO_VIDEO_ENGINE_ENABLED=false
AVANTIQO_VIDEO_ENGINE_QUALITY_SCORE=92
AVANTIQO_VIDEO_ENGINE_SPEED_SCORE=72
AVANTIQO_VIDEO_ENGINE_RELIABILITY_SCORE=82
RUNPOD_AVANTIQO_VIDEO_API_KEY=
RUNPOD_AVANTIQO_VIDEO_ENDPOINT_ID=

# Avantiqo-owned Voice
RUNPOD_AVANTIQO_VOICE_STT_ENDPOINT_ID=
RUNPOD_AVANTIQO_VOICE_TTS_ENDPOINT_ID=

# Avantiqo-owned Music / Audio / SFX
