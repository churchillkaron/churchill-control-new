FROM vllm/vllm-openai:v0.27.1

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/runpod-volume/huggingface-cache \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    VLLM_USE_FLASHINFER_SAMPLER=0 \
    AVANTIQO_CODE_DEVICE=cuda \
    AVANTIQO_CODE_QUANTIZATION=fp8 \
    AVANTIQO_CODE_FOUNDATION_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct \
    AVANTIQO_CODE_RUNTIME_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8 \
    AVANTIQO_CODE_MAX_MODEL_LEN=32768 \
    AVANTIQO_CODE_GPU_MEMORY_UTILIZATION=0.90 \
    AVANTIQO_CODE_MAX_NEW_TOKENS=4096

WORKDIR /app

# Use vLLM's own tested PyTorch/CUDA stack. vLLM ships compiled CUDA kernels
# that are binary-sensitive to the exact torch/CUDA build, so do not layer it
# onto an unrelated PyTorch base image. The requirements pin RunPod to the
# newest SDK whose FastAPI range remains compatible with vLLM 0.27.1.
COPY services/avantiqo-code-engine/requirements.txt ./requirements.txt
RUN uv pip install --system -r requirements.txt \
    && python3 -c "from importlib.metadata import version; import runpod, vllm; assert version('runpod') == '1.10.0', version('runpod'); assert version('vllm') == '0.27.1', version('vllm'); print('AVANTIQO_CODE_VLLM_BUILD_CHECK=PASS')"
COPY services/avantiqo-code-engine/handler.py ./handler.py
COPY services/avantiqo-code-engine/serverless_boot.py ./serverless_boot.py
RUN python3 -m py_compile handler.py serverless_boot.py

# Serverless uses a dedicated boot entrypoint that loads the already-certified
# Code engine before RunPod begins accepting work. This allows FlashBoot to
# snapshot a model-resident worker after scale-down instead of a model-free
# Python process. The shared handler remains unchanged for the certified Pod lane.
ENTRYPOINT ["python3", "-u", "serverless_boot.py"]
