FROM pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/runpod-volume/huggingface-cache \
    TRANSFORMERS_CACHE=/runpod-volume/huggingface-cache \
    AVANTIQO_INTELLIGENCE_TRAINER_OUTPUT_ROOT=/runpod-volume/avantiqo-intelligence-training \
    AVANTIQO_INTELLIGENCE_TRAINER_ENABLED=false \
    VIRTUAL_ENV=/opt/avantiqo-intelligence-trainer-venv

ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && /usr/bin/python3 -m venv --system-site-packages "${VIRTUAL_ENV}"

COPY services/avantiqo-intelligence-trainer/requirements.txt ./requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements.txt \
    && python - <<'PY'
from importlib.metadata import PackageNotFoundError, version
assert version("runpod") == "1.12.0", version("runpod")
assert version("transformers") == "5.15.0", version("transformers")
assert version("peft") == "0.20.0", version("peft")
assert version("accelerate") == "1.14.0", version("accelerate")
try:
    version("bitsandbytes")
except PackageNotFoundError:
    pass
else:
    raise AssertionError("bitsandbytes must not be installed in the fused Qwen3-MoE BF16 trainer")
print("AVANTIQO_INTELLIGENCE_TRAINER_DEPENDENCY_CHECK=PASS")
print("AVANTIQO_INTELLIGENCE_TRAINER_METHOD=LORA_BF16_PEFT_QWEN3_MOE")
PY

COPY services/avantiqo-intelligence-trainer/handler.py ./handler.py
RUN python -m py_compile handler.py

ENTRYPOINT ["python", "-u", "handler.py"]
