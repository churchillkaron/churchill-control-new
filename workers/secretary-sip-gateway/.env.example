# Avantiqo Secretary owned SIP gateway - non-secret template only.
# Copy to a local untracked env file and fill real values there.

AVANTIQO_SECRETARY_SIP_GATEWAY_TOKEN=
AVANTIQO_SECRETARY_PUBLIC_BASE_URL=http://host.docker.internal:3000
AVANTIQO_SECRETARY_CALL_GATEWAY_TOKEN=

ASTERISK_AMI_HOST=host.docker.internal
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=avantiqo-secretary
ASTERISK_AMI_SECRET=
ASTERISK_AMI_RECONNECT_MS=5000
ASTERISK_SECRETARY_INBOUND_CONTEXT=avantiqo-secretary-inbound
ASTERISK_SECRETARY_OUTBOUND_CONTEXT=avantiqo-secretary-outbound
ASTERISK_SECRETARY_OUTBOUND_EXTEN=s
ASTERISK_SECRETARY_OUTBOUND_CHANNEL_TEMPLATE=PJSIP/{destination}@avantiqo-trunk
ASTERISK_SECRETARY_AUDIOSOCKET_SERVICE=secretary-sip-gateway:9019

# Provider-neutral SIP/PSTN transport. Real credentials belong only in .env.local.
# Exact PJSIP endpoint name. Keep the default unless a local installation needs another name.
ASTERISK_SECRETARY_TRUNK_ENDPOINT=avantiqo-trunk
# Carrier SIP hostname or IP, never an Avantiqo intelligence/state authority.
ASTERISK_SECRETARY_TRUNK_HOST=
ASTERISK_SECRETARY_TRUNK_PORT=5060
ASTERISK_SECRETARY_TRUNK_PROTOCOL=udp
# Leave username/secret blank only for IP-authenticated trunks that require no registration.
ASTERISK_SECRETARY_TRUNK_USERNAME=
ASTERISK_SECRETARY_TRUNK_SECRET=
# true for credential-based SIP registration; false for IP-authenticated trunks.
ASTERISK_SECRETARY_TRUNK_REGISTER=true
ASTERISK_SECRETARY_TRUNK_CLIENT_USER=
ASTERISK_SECRETARY_TRUNK_CONTACT_USER=
# Host/IP/CIDR accepted as inbound traffic for this endpoint. Defaults to TRUNK_HOST when omitted.
ASTERISK_SECRETARY_TRUNK_IDENTIFY_MATCH=
ASTERISK_SECRETARY_TRUNK_FROM_USER=
ASTERISK_SECRETARY_TRUNK_CODECS=ulaw,alaw

# Real Asterisk preflight remains non-call/non-spend.
# Set true once the intended trunk is locally configured and must be present for PASS.
SECRETARY_ASTERISK_PREFLIGHT_REQUIRE_TRUNK=false
SECRETARY_ASTERISK_PREFLIGHT_REQUIRE_REGISTERED=false
SECRETARY_ASTERISK_PREFLIGHT_CONNECT_TIMEOUT_MS=10000
SECRETARY_ASTERISK_PREFLIGHT_ACTION_TIMEOUT_MS=10000

# One-shot real-call certification safeguards. Never commit or paste real numbers here.
SECRETARY_SIP_REAL_CALL_APPROVED=NO
SECRETARY_SIP_REAL_CALL_DESTINATION=
SECRETARY_SIP_REAL_CALL_ALLOWLIST_DESTINATION=

SECRETARY_GATEWAY_HTTP_PORT=8787
SECRETARY_GATEWAY_AUDIO_PORT=9019
SECRETARY_GATEWAY_AUDIO_BIND=127.0.0.1
SECRETARY_GATEWAY_VAD_THRESHOLD=450
SECRETARY_GATEWAY_VAD_SILENCE_MS=650
SECRETARY_GATEWAY_VAD_MIN_SPEECH_MS=280
SECRETARY_GATEWAY_VAD_MAX_SPEECH_MS=12000
