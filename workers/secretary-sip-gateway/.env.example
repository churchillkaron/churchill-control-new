# Avantiqo Secretary owned SIP gateway - non-secret template only.
# Copy to a local untracked env file and fill real values there.

AVANTIQO_SECRETARY_SIP_GATEWAY_TOKEN=
AVANTIQO_SECRETARY_PUBLIC_BASE_URL=http://host.docker.internal:3000
AVANTIQO_SECRETARY_CALL_GATEWAY_TOKEN=

ASTERISK_AMI_HOST=host.docker.internal
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=avantiqo-secretary
ASTERISK_AMI_SECRET=
ASTERISK_SECRETARY_OUTBOUND_CONTEXT=avantiqo-secretary-outbound
ASTERISK_SECRETARY_OUTBOUND_EXTEN=s
ASTERISK_SECRETARY_OUTBOUND_CHANNEL_TEMPLATE=PJSIP/{destination}@avantiqo-trunk
ASTERISK_SECRETARY_AUDIOSOCKET_SERVICE=secretary-sip-gateway:9019

SECRETARY_GATEWAY_HTTP_PORT=8787
SECRETARY_GATEWAY_AUDIO_PORT=9019
SECRETARY_GATEWAY_AUDIO_BIND=127.0.0.1
SECRETARY_GATEWAY_VAD_THRESHOLD=450
SECRETARY_GATEWAY_VAD_SILENCE_MS=650
SECRETARY_GATEWAY_VAD_MIN_SPEECH_MS=280
SECRETARY_GATEWAY_VAD_MAX_SPEECH_MS=12000
